SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=your-email@gmail.com

AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

FRED_API_KEY=
# 부동산: 공개 통계 파일/시트 URL JSON 목록 (키/로그인 불요). 예:
# REAL_ESTATE_SOURCES=[{"key":"k1","name":"전국 주택가격","kind":"csv","url":"https://..."}]
REAL_ESTATE_SOURCES=
# 가격/거래량 이상 감지 워치리스트 (비워두면 기본: 팔라듐/백금/금/은/원유/구리 + FRED 매크로).
# "backend": "yahoo"(키 없는 일봉 OHLCV) 또는 "fred"(FRED_API_KEY 사용, 가격만).
# 예: PRICE_WATCH_SOURCES=[{"key":"pa","name":"팔라듐 (Palladium)","backend":"yahoo","symbol":"PA=F","threshold":1.5,"volume_ratio":2.5}]
PRICE_WATCH_SOURCES=
HN_MIN_POINTS=50
HN_HOURS_BACK=48
TOP_N=5
EMERGING_N=5
BREAKOUT_N=3
